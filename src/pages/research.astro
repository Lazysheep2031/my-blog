---
import MainGridLayout from "@layouts/MainGridLayout.astro";
import PostPage from "../components/PostPage.astro";
import { getSortedPosts } from "../utils/content-utils";
const researchPosts = (await getSortedPosts()).filter(post => !post.data.draft && post.data.category?.trim() === "科研");
---
<MainGridLayout title="科研" description="科研与论文阅读记录">
    <div class="page-heading">
        <p class="eyebrow">RESEARCH</p>
        <h1>科研<span class="brand-dot">.</span></h1>
    </div>
    {researchPosts.length ? <PostPage page={{ data: researchPosts }} /> : <p class="text-50">暂无科研内容</p>}
</MainGridLayout>
