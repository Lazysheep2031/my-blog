---
import MainGridLayout from "../layouts/MainGridLayout.astro";
import PostPage from "../components/PostPage.astro";
import { getSortedPosts } from "../utils/content-utils";
import { url } from "../utils/url-utils";
const posts = (await getSortedPosts()).filter(post => !post.data.draft)
    .sort((a, b) => Math.max(+b.data.published, +(b.data.updated || b.data.published)) - Math.max(+a.data.published, +(a.data.updated || a.data.published)) || a.slug.localeCompare(b.slug));
---
<MainGridLayout title="首页" description="Lazysheep 的课程笔记、研究与学习记录。Be Happy Every Day.">
    <div class="opening" aria-hidden="true">
        <div class="opening-copy"><span>Lazysheep<span class="opening-dot">.</span></span><p>Be Happy Every Day</p></div>
    </div>
    <section class="home-intro">
        <p class="eyebrow">NOTES & EXPLORATIONS</p>
        <h1>Lazysheep<span class="brand-dot">.</span></h1>
        <p class="home-motto">Be Happy Every Day</p>
    </section>
    <section aria-labelledby="recent-heading">
        <div class="section-heading"><h2 id="recent-heading">最近更新</h2><a href={url('/blog/')}>全部文章 <span aria-hidden="true">↗</span></a></div>
        <PostPage page={{ data: posts.slice(0, 5) }} />
    </section>
</MainGridLayout>
