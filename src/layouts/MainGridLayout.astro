---
import BackToTop from "@components/control/BackToTop.astro";
import Footer from "@components/Footer.astro";
import Navbar from "@components/Navbar.astro";
import type { MarkdownHeading } from "astro";
import TOC from "../components/widget/TOC.astro";
import { siteConfig } from "../config";
import Layout from "./Layout.astro";
interface Props {
    title?: string;
    banner?: string;
    description?: string;
    lang?: string;
    setOGTypeArticle?: boolean;
    headings?: MarkdownHeading[];
    landing?: boolean;
}
const { title, description, lang, setOGTypeArticle, headings = [] } = Astro.props;
const showToc = setOGTypeArticle && siteConfig.toc.enable && headings.length > 0;
---
<Layout title={title} description={description} lang={lang} setOGTypeArticle={setOGTypeArticle}>
    <slot slot="head" name="head" />
    <header id="top-row" class="site-header">
        <div id="navbar-wrapper"><Navbar /></div>
    </header>
    <div class="site-shell">
        <div id="main-grid" class:list={["transition-swup-fade editorial-grid", { "reading-grid": showToc }]}>
            <main id="swup-container" class="min-w-0">
                <div id="content-wrapper"><slot /></div>
            </main>
            {showToc && <aside id="toc-wrapper" class="reading-toc">
                <div id="toc-inner-wrapper">
                    <div class="toc-label">本页目录</div>
                    <div id="toc"><TOC headings={headings} /></div>
                </div>
            </aside>}
            <footer class="site-footer"><Footer /></footer>
        </div>
        <BackToTop />
    </div>
</Layout>
