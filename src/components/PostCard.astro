---
import type { CollectionEntry } from "astro:content";
interface Props {
    entry: CollectionEntry<"posts">;
    title: string;
    url: string;
    published: Date;
    updated?: Date;
    tags: string[];
    category: string | null;
    description: string;
    image?: string;
    draft?: boolean;
    class?: string;
    style?: string;
}
const { title, url, published, updated, tags, category, description } = Astro.props;
const date = updated && updated > published ? updated : published;
const dateText = new Intl.DateTimeFormat("zh-CN", { year: "numeric", month: "2-digit", day: "2-digit" }).format(date);
---
<article class="post-row">
    <time datetime={date.toISOString()} class="post-date">{dateText}</time>
    <div class="post-row-copy">
        <div class="post-topic">{tags[0] || category || "随笔"}</div>
        <h2><a href={url}>{title}<span aria-hidden="true" class="post-arrow">↗</span></a></h2>
        {description && <p>{description}</p>}
    </div>
</article>
