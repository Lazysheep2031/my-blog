---
import type { CollectionEntry } from "astro:content";
import { getPostUrlBySlug } from "@utils/url-utils";
import PostCard from "./PostCard.astro";
interface Props { page: { data: CollectionEntry<"posts">[] } }
const { page } = Astro.props;
---
<div class="post-list">
    {page.data.map((entry) => <PostCard entry={entry} {...entry.data} url={getPostUrlBySlug(entry.slug)} />)}
</div>
